<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vanguard AI Buddy</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col m-0 relative">

    <!-- LOGIN OVERLAY -->
    <div id="login-overlay" class="absolute inset-0 bg-gray-900/80 z-50 flex items-center justify-center">
        <div class="bg-white p-8 rounded-xl shadow-2xl max-w-sm w-full text-center">
            <h3 class="font-bold text-2xl mb-2">Vanguard Portal</h3>
            <p class="text-gray-500 mb-6 text-sm">Enter your work email to access your live onboarding data.</p>
            <input type="email" id="employee-email" class="w-full p-3 border border-gray-300 rounded-lg mb-4 text-left" placeholder="you@example.com">
            <button onclick="fetchLiveEmployeeData()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">Connect to Database</button>
            <p id="login-status" class="text-sm mt-4 font-bold text-blue-600"></p>
        </div>
    </div>
  
    <header style="background-color: #2563eb; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #1e40af; width: 100%;">
        <h2 style="font-weight: bold; font-size: 24px; margin: 0; display: flex; align-items: center; gap: 12px;">
            🤖 Your Onboarding Buddy
        </h2>
    </header>

    <main class="flex-1 w-full max-w-4xl mx-auto p-6 md:p-10 relative flex flex-col">
        <div id="view-chat" class="flex flex-1 flex-col w-full h-[75vh] bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div id="chat-messages" class="flex-1 overflow-y-auto p-6 flex flex-col gap-4 bg-gray-50/50">
                <div class="bg-white border border-gray-200 text-gray-800 p-4 rounded-xl max-w-[80%] self-start text-base shadow-sm">
                    Hi there! I am connecting to the Vanguard HR database... please login above!
                </div>
            </div>

            <form id="chat-form" class="p-4 border-t border-gray-200 bg-white flex gap-3">
                <input type="text" id="chat-input" placeholder="Type a message..." class="flex-1 p-3 rounded-lg border border-gray-300 bg-gray-50 text-gray-900 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-inner transition" disabled>
                <button type="submit" id="send-btn" class="bg-gray-400 text-white font-bold px-8 py-3 rounded-lg shadow-sm" disabled>Send</button>
            </form>
        </div>
    </main>
    
  <script>
    // ==========================================
    // 🛑 PASTE YOUR KEYS HERE
    // ==========================================
    const GEMINI_API_KEY = "AQ.Ab8RN6LSCFer5sytlGvhM4k_cLVFhDVh_JbnR7z1hiFKUuXrPA";
    const GOOGLE_SHEET_API_URL = "https://script.google.com/macros/s/AKfycbyYJSWmfyavAx7_NbXhPsxuwT32G8xSCFwhn0P9N-iwp5xdMERN7qyH48xYxk9TjCHR/exec";

    let liveEmployeeContext = ""; // This will hold the live data from Excel

    // --- 1. Fetch Live Data from Google Sheets API ---
    async function fetchLiveEmployeeData() {
        const email = document.getElementById('employee-email').value.trim();
        const statusText = document.getElementById('login-status');
        
        if(!email) {
            statusText.innerText = "Please enter an email.";
            statusText.className = "text-sm mt-4 font-bold text-red-500";
            return;
        }

        statusText.innerText = "Connecting to Google Sheets...";
        statusText.className = "text-sm mt-4 font-bold text-blue-600";

        try {
            // Call the Google Apps Script Web App
            const response = await fetch(`${GOOGLE_SHEET_API_URL}?email=${encodeURIComponent(email)}`);
            const data = await response.json();

            if(data.error) {
                statusText.innerText = "Error: " + data.error;
                statusText.className = "text-sm mt-4 font-bold text-red-500";
            } else {
                // Success! Build the live system prompt context
                liveEmployeeContext = `
                The user you are speaking to is named: ${data.name}.
                Their Background Check (BGC) Status is: ${data.bgcStatus}.
                Their Overall Onboarding Status is: ${data.onboardingStatus}.
                
                Here is their EXACT mandatory training completion status right now:
                - Information Security (InfoSec): ${data.trainings.infoSec}
                - Code of Conduct: ${data.trainings.codeOfConduct}
                - POSH: ${data.trainings.posh}
                - Data Privacy: ${data.trainings.dataPrivacy}
                `;

                // Hide overlay and unlock chat
                document.getElementById('login-overlay').style.display = 'none';
                document.getElementById('chat-input').disabled = false;
                document.getElementById('send-btn').disabled = false;
                document.getElementById('send-btn').className = "bg-blue-600 text-white font-bold px-8 py-3 rounded-lg hover:bg-blue-700 transition shadow-sm";

                appendMessage(`Welcome ${data.name}! I have securely loaded your profile from the Vanguard database. You can ask me exactly which trainings you still need to complete, or anything else about your onboarding!`, false);
            }
        } catch (error) {
            statusText.innerText = "Network Error connecting to API.";
            statusText.className = "text-sm mt-4 font-bold text-red-500";
        }
    }

    // --- 2. Chat UI Helper ---
    function appendMessage(text, isUser) {
        const msgs = document.getElementById('chat-messages');
        if (isUser) {
            msgs.innerHTML += `<div class="bg-blue-600 text-white p-4 rounded-xl max-w-[80%] self-end text-base shadow-md">${text}</div>`;
        } else {
            let formattedText = text.replace(/\n/g, "<br>");
            msgs.innerHTML += `<div class="bg-white border border-gray-200 text-gray-800 p-4 rounded-xl max-w-[80%] self-start text-base shadow-sm">${formattedText}</div>`;
        }
        msgs.scrollTop = msgs.scrollHeight;
    }

    // --- 3. Ask Gemini with Live Context ---
    document.getElementById('chat-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('chat-input');
        const userQuestion = input.value.trim();
        if (!userQuestion) return;
        
        appendMessage(userQuestion, true);
        input.value = '';

        const msgs = document.getElementById('chat-messages');
        const typingId = "typing-" + Date.now();
        msgs.innerHTML += `<div id="${typingId}" class="bg-gray-100 text-gray-500 p-4 rounded-xl max-w-[80%] self-start text-base italic shadow-sm">Thinking...</div>`;
        msgs.scrollTop = msgs.scrollHeight;

        // Combine the static rules with the LIVE employee data
        const systemPrompt = `
        You are a friendly Onboarding Buddy AI for a new joiner at "Vanguard".
        Use the following LIVE DATABASE CONTEXT to answer the user's questions about their profile.
        
        ${liveEmployeeContext}

        OTHER GENERAL COMPANY DATA:
        - Manager: Sarah Jenkins.
        - IT Support: Email itsupport@vanguard.com.
        `;

        const finalPromptText = "System Instructions:\n" + systemPrompt + "\n\nUser Question:\n" + userQuestion;

        try {
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key=${GEMINI_API_KEY}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contents: [{ role: "user", parts: [{ text: finalPromptText }] }]
                })
            });

            const data = await response.json();
            document.getElementById(typingId).remove();

            if (data.candidates && data.candidates.length > 0) {
                appendMessage(data.candidates[0].content.parts[0].text, false);
            } else {
                appendMessage("API Error: " + (data.error ? data.error.message : "Unknown error"), false);
            }
        } catch (error) {
            document.getElementById(typingId).remove();
            appendMessage("Network error connecting to Gemini API.", false);
        }
    });
  </script>
</body>
</html>
